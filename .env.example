# -----------------------------------------------------------------------------
# JARVIS V1 ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# SERVER-ONLY SECRETS (Backend - apps/brain)
# -----------------------------------------------------------------------------
# Database Connection (PostgreSQL or SQLite file URL)
DATABASE_URL="file:./dev.db"

# Google Gemini API Keys (Multi-Key Pool: Comma-separated list of keys from distinct Google Cloud projects)
# Leveraging multiple project keys multiplies free-tier RPM and eliminates single-project rate limits.
GEMINI_API_KEYS="key_proj1,key_proj2,key_proj3,key_proj4,key_proj5,key_proj6,key_proj7,key_proj8,key_proj9,key_proj10"
# Single key fallback (backwards compatible)
GEMINI_API_KEY=""

# Web Search API Key (Tavily or fallback search provider, optional)
SEARCH_API_KEY=""

# Weather API Key (OpenWeatherMap or Open-Meteo fallback, optional)
WEATHER_API_KEY=""

# Jarvis API Master Secret / Auth Bearer Key (for authenticating client requests)
JARVIS_API_SECRET="jarvis-v1-secret-key-change-in-production"

# Application Node Environment
NODE_ENV="development"
PORT=3000

# PUBLIC / MOBILE CONFIG (apps/mobile)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_JARVIS_API_URL="http://localhost:3000/api/v1"
EXPO_PUBLIC_JARVIS_API_KEY="jarvis-v1-secret-key-change-in-production"

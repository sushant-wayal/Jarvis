{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "jarvis",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0D14"
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#00DBE9"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Jarvis needs access to your microphone to process voice commands and talk with you.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.jarvis.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0D14"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS",
        "READ_SMS",
        "BIND_NOTIFICATION_LISTENER_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withNotificationListener"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca864547-142c-47c6-a8d3-a660251a66df"
      }
    },
    "owner": "sushant_wayal"
  }
}

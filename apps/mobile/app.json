{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "jarvis",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Jarvis needs access to your microphone to process voice commands and talk with you.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.jarvis.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0D14"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_MICROPHONE",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS",
        "READ_SMS",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "POST_NOTIFICATIONS",
        "QUERY_ALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "./plugins/withNotificationListener",
      "./plugins/withAndroidEarbudService",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00DBE9"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0D14"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca864547-142c-47c6-a8d3-a660251a66df"
      }
    },
    "owner": "sushant_wayal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca864547-142c-47c6-a8d3-a660251a66df"
    }
  }
}

{
  "name": "jarvis-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --profile preview --clear-cache",
    "build:apk:prod": "eas build --platform android --profile production --clear-cache",
    "prebuild": "expo prebuild --clean --platform android",
    "build:local:apk": "expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease",
    "build:local:apk:win": "expo prebuild --clean --platform android && cd android && gradlew.bat assembleRelease",
    "update:preview": "eas update --channel preview --message",
    "update:prod": "eas update --channel production --message",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "npm run build:shared --prefix ../.."
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@jarvis/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-sms": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.4",
    "cross-env": "^7.0.3",
    "typescript": "~6.0.3"
  },
  "private": true
}

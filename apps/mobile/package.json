{
  "name": "jarvis-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --profile preview --clear-cache",
    "build:apk:prod": "eas build --platform android --profile production --clear-cache",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jarvis/shared": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.14",
    "expo-contacts": "~15.0.11",
    "expo-gl": "~16.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.29.14",
    "expo-router": "~6.0.24",
    "expo-sms": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "typescript": "~5.6.3"
  },
  "private": true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  name          String         @default("Sushant")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  preferences   String?        // JSON string of user settings & preferences
  conversations Conversation[]
  memories      Memory[]
  devices       Device[]
  agentRuns     AgentRun[]
  tasks         Task[]
  notifications Notification[]
}

model Conversation {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String          @default("New Conversation")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       Message[]
  toolExecutions ToolExecution[]
  agentRuns      AgentRun[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // USER, ASSISTANT, SYSTEM, TOOL
  content        String
  inputType      String       @default("TEXT") // TEXT, VOICE
  createdAt      DateTime     @default(now())
  metadata       String?      // JSON metadata string
}

model Memory {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    // FACT, PREFERENCE, PERSON, PROJECT, ROUTINE, GOAL, CONSTRAINT, HABIT, CONTEXT
  content          String
  importance       Int       @default(3) // 1 to 5 scale
  confidence       Float     @default(0.9) // 0.0 to 1.0
  source           String?   // 'USER_EXPLICIT', 'EXTRACTED_CONVERSATION', 'AGENT_OBSERVATION'
  lastReferencedAt DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, type])
}

model ToolExecution {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName       String
  input          String       // JSON payload
  output         String       // JSON payload
  status         String       // SUCCESS, FAILED
  durationMs     Int
  createdAt      DateTime     @default(now())
}

model AgentRun {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String      // PENDING, PLANNING, EXECUTING, WAITING_FOR_USER, COMPLETED, FAILED, CANCELLED
  goal           String
  error          String?
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  steps          AgentStep[]

  @@index([userId, status])
  @@index([conversationId])
}

model AgentStep {
  id          String    @id @default(uuid())
  agentRunId  String
  agentRun    AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepNumber  Int
  type        String    // THINK, TOOL_CALL, OBSERVATION, RESPONSE, WAIT, CONFIRMATION
  status      String    // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED
  input       String?   // JSON input / arguments
  output      String?   // JSON output / results
  summary     String?   // Concise human-readable safe summary
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentRunId, stepNumber])
}

model Task {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String          // REMINDER, SCHEDULED_TASK, RECURRING_TASK, CONDITIONAL_TASK
  title       String
  description String?
  status      String          @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, FAILED, CANCELLED
  schedule    String?         // ISO datetime or Cron expression
  condition   String?         // Conditional trigger description or rule
  timezone    String          @default("UTC")
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  executions  TaskExecution[]
  notifications Notification[]

  @@index([userId, status])
  @@index([nextRunAt, status])
}

model TaskExecution {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   // SUCCESS, FAILED
  result      String?  // JSON execution summary
  durationMs  Int      @default(0)
  executedAt  DateTime @default(now())

  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title     String
  body      String
  deepLink  String?
  status    String   @default("PENDING") // PENDING, SENT, FAILED, DISMISSED
  createdAt DateTime @default(now())

  @@index([userId, status])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  platform     String   // iOS, Android, Web
  appVersion   String
  pushToken    String?
  capabilities String?  // JSON array of capabilities (VOICE_INPUT, AUDIO_OUTPUT, etc.)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}
